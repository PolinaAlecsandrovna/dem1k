<Window x:Class="dem1k.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dem1k"
        mc:Ignorable="d"
        Title="Заказы - СтройМатериалы" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Calibri">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#DAA520" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Список заказов" VerticalAlignment="Center" 
                       HorizontalAlignment="Center" FontSize="24" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnAddOrder" Grid.Column="1" Content="Добавить заказ" Margin="10" Padding="10,5" 
                    Background="#B8860B" Foreground="White" Click="BtnAddOrder_Click" Visibility="Collapsed"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl x:Name="icOrders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" 
                                MouseLeftButtonUp="Order_Click" Cursor="Hand" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Article, StringFormat='Артикул заказа: {0}'}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding StatusName, StringFormat='Статус заказа: {0}'}"/>
                                    <TextBlock Text="{Binding PickupAddress, StringFormat='Адрес пункта выдачи: {0}'}"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                                </StackPanel>

                                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" CornerRadius="5" 
                                        VerticalAlignment="Center" Height="60" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Дата доставки" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DeliveryDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                   HorizontalAlignment="Center" FontSize="16"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
