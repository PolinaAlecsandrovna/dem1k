<Window x:Class="dem1k.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dem1k"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Calibri">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Наименование:" Grid.Row="0" Margin="0,5"/>
        <TextBox x:Name="txtName" Grid.Row="1" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Цена:" Grid.Row="2" Margin="0,5"/>
        <TextBox x:Name="txtPrice" Grid.Row="3" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Количество на складе:" Grid.Row="4" Margin="0,5"/>
        <TextBox x:Name="txtQuantity" Grid.Row="5" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Скидка (%):" Grid.Row="6" Margin="0,5"/>
        <TextBox x:Name="txtDiscount" Grid.Row="7" Height="25" Margin="0,0,0,10"/>

        <TextBlock Text="Путь к изображению:" Grid.Row="8" Margin="0,5"/>
        <TextBox x:Name="txtImagePath" Grid.Row="9" Height="25" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Width="100" Height="30" Margin="10" Background="#B8860B" Foreground="White" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="100" Height="30" Margin="10" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
