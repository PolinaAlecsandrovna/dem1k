<Window x:Class="dem1k.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dem1k"
        mc:Ignorable="d"
        Title="Авторизация - СтройМатериалы" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Calibri">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="/Resources/logo.png" Height="80" Margin="0,20,0,0" Stretch="Uniform"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="30" FontSize="14" Padding="5"/>

            <TextBlock Text="Пароль:" FontSize="14" Margin="0,15,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" FontSize="14" Padding="5"/>

            <Button x:Name="btnLogin" Content="Войти" Height="40" Margin="0,25,0,10" 
                    Background="#B8860B" Foreground="White" FontSize="16" FontWeight="Bold"
                    Click="BtnLogin_Click"/>

            <Button x:Name="btnGuest" Content="Войти как гость" Height="40" 
                    Background="#DAA520" Foreground="White" FontSize="16"
                    Click="BtnGuest_Click"/>
        </StackPanel>

        <TextBlock x:Name="lblError" Grid.Row="2" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,20"/>
    </Grid>
</Window>
